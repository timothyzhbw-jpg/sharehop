{
  "name": "sharehop",
  "version": "0.3.0",
  "description": "A small, framework-free share panel for any website: copy link, QR code, native share and 40+ apps (WhatsApp, WeChat, X, LINE, Weibo…) with a plug-in API for your own — as a Web Component with a thin React wrapper.",
  "license": "MIT",
  "author": "Bowen Zhang",
  "homepage": "https://github.com/timothyzhbw-jpg/sharehop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timothyzhbw-jpg/sharehop.git"
  },
  "bugs": {
    "url": "https://github.com/timothyzhbw-jpg/sharehop/issues"
  },
  "type": "module",
  "keywords": [
    "copy-link",
    "custom-element",
    "deep-link",
    "qr-code",
    "react",
    "share",
    "share-button",
    "share-buttons",
    "share-sheet",
    "social-share",
    "web-component",
    "web-share-api",
    "wechat",
    "whatsapp"
  ],
  "sideEffects": [
    "./dist/element/define.js",
    "./dist/sharehop.global.js",
    "./dist/sharehop.lite.global.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    },
    "./define": {
      "types": "./dist/element/define.d.ts",
      "default": "./dist/element/define.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./global": "./dist/sharehop.global.js",
    "./lite": "./dist/sharehop.lite.global.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "demo": "node scripts/serve.mjs",
    "check-targets": "node scripts/check-targets.mjs",
    "icons": "node scripts/gen-brand-icons.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "simple-icons": "^16.38.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
